# Optional tuning. NO TinyFish key goes here: users paste their own key in the UI.
JOBSCOUT_MAX_SOURCES=8
JOBSCOUT_MAX_DETAIL_FETCHES=20
# Development only; ignored in production builds.
# NEXT_PUBLIC_ENABLE_FIXTURES=true

# --- Auth (required in production; the app refuses to sign anyone in without them) ---
# 32+ random chars:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
# email|salt:hash entries separated by ';'.  Generate: npm run auth:hash -- you@example.com 'password'
JOBSCOUT_USERS=
# Optional public text shown on the login page (e.g. credentials for judges).
# NEXT_PUBLIC_DEMO_HINT=judge@example.com / your-demo-password
